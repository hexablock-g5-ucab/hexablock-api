generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLAYER
  ADMIN
}

model User {
  id           String          @id @default(uuid())
  email        String          @unique
  passwordHash String
  displayName  String
  role         Role            @default(PLAYER)
  createdAt    DateTime        @default(now())
  progress     GameProgress[]
  levels       LevelProgress[]
  scores       Score[]
}

model GameProgress {
  userId    String
  gameId    String
  bestScore Int      @default(0)
  data      Json     @default("{}")
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@id([userId, gameId])
}

model LevelProgress {
  userId      String
  gameId      String
  levelId     String
  stars       Int       @default(0)
  bestScore   Int       @default(0)
  completedAt DateTime?
  user        User      @relation(fields: [userId], references: [id])

  @@id([userId, gameId, levelId])
}

model Score {
  id        String   @id @default(uuid())
  userId    String
  gameId    String
  levelId   String?
  score     Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([gameId, levelId, score(sort: Desc)])
}

model Level {
  gameId     String
  levelId    String
  version    Int      @default(1)
  sortOrder  Int
  difficulty String
  spec       Json
  updatedAt  DateTime @updatedAt

  @@id([gameId, levelId])
}
