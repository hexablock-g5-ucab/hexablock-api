---
title: "HexaBlock Suite · Modelo de clases v6.3 (5/5) — API REST · hexablock-api (NestJS + Prisma)"
config:
  layout: elk
  theme: base
  themeVariables:
    fontFamily: "Inter"
    fontSize: "15px"
  class:
    hideEmptyMembersBox: true
---
classDiagram
  direction LR

  %% ===================== src/domain =====================
  class User {
    +id: string
    +email: string
    +displayName: string
    +role: PLAYER | ADMIN
  }
  class GameProgress {
    +userId: string
    +gameId: string
    +bestScore: number
    +data: Record‹string, unknown› — datos propios del modelo de progreso del juego
    +mergeMonotonic(incoming: GameProgress, policy: IProgressMergePolicy) GameProgress
  }
  class IProgressMergePolicy {
    <<interface · Strategy · punto de extensión por gameId>>
    +merge(stored: Record‹string, unknown›, incoming: Record‹string, unknown›) Record‹string, unknown›
  }
  class KeepLatestDataPolicy {
    <<política por defecto>>
  }
  class LevelProgress {
    +userId: string
    +gameId: string
    +levelId: string
    +bestScore: number
    +completedAt: Date?
    +data: Record‹string, unknown› — por ejemplo estrellas, si una variante las usa
  }
  class ScoreEntry {
    +userId: string
    +gameId: string
    +levelId: string?
    +score: number
    +moves: number
    +elapsedMs: number
  }
  class LevelDefinition {
    <<formato genérico>>
    +gameId: string
    +levelId: string
    +schemaVersion: number
    +order: number
    +difficulty: string?
    +board: BoardSpec
    +spec: unknown — sección propia del gameId
  }
  class IRankingStrategy {
    <<interface · Strategy>>
    +rank(entries: ScoreEntry[]) RankedEntry[]
  }
  class BestScoreRanking
  class ILevelSpecValidator {
    <<interface · Strategy · punto de extensión>>
    +gameId: string
    +validate(spec: unknown) void
  }
  class SortLevelSpecValidator
  class GameIdPipe {
    <<pipe · valida gameId contra SUPPORTED_GAMES>>
  }
  class DomainError {
    <<abstract>>
  }

  %% ===================== src/application =====================
  class UseCase~I, O~ {
    <<interface>>
    +execute(input: I) Promise~O~
  }
  class RegisterUserUseCase
  class LoginUseCase
  class SyncProgressUseCase {
    -policies: Map‹string, IProgressMergePolicy› — por gameId; si falta, KeepLatestDataPolicy
    +execute(i: SyncProgressInput) Promise~GameProgress~
  }
  class SubmitScoreUseCase
  class GetLeaderboardUseCase {
    -strategies: Map‹string, IRankingStrategy› — por gameId; si falta, BestScoreRanking
    +execute(q: LeaderboardQuery) Promise~RankedEntry[]~
  }
  class ReadProgressUseCase
  class ReadProfileUseCase
  class AdminGuard {
    <<guard · escritura de niveles>>
    +canActivate(ctx) bool — role = ADMIN del usuario autenticado
  }
  class GetLevelsUseCase
  class UpsertLevelUseCase {
    -validators: Map‹string, ILevelSpecValidator›
  }
  class LoggingUseCase~I, O~ {
    <<AOP · Decorator>>
    -inner: UseCase‹I, O›
  }
  class LogPort {
    <<interface · puerto>>
    +record(operation, outcome, duration) void
  }
  class NestLogAdapter
  class UserRepository {
    <<interface · puerto>>
  }
  class ProgressRepository {
    <<interface · puerto>>
  }
  class ScoreRepository {
    <<interface · puerto>>
  }
  class LevelRepository {
    <<interface · puerto>>
  }
  class PasswordHasher {
    <<interface · puerto>>
  }
  class TokenService {
    <<interface · puerto>>
  }

  %% ===================== src/infrastructure =====================
  class PrismaService {
    <<PrismaClient>>
  }
  class PrismaUserRepository {
    <<Adapter>>
  }
  class PrismaProgressRepository {
    <<Adapter>>
  }
  class PrismaScoreRepository {
    <<Adapter>>
  }
  class PrismaLevelRepository {
    <<Adapter>>
  }
  class BcryptPasswordHasher {
    <<Adapter>>
  }
  class JwtTokenService {
    <<Adapter>>
  }

  %% ===================== src/interfaces/http =====================
  class AuthController {
    POST /auth/register · POST /auth/login · GET /me
  }
  class ProgressController {
    GET · PUT /progress/:gameId
  }
  class LeaderboardController {
    POST /games/:gameId/scores
    GET /games/:gameId/leaderboard
  }
  class LevelsController {
    GET /games/:gameId/levels
    PUT /games/:gameId/levels/:levelId  (admin)
  }
  class JwtAuthGuard {
    <<guard>>
  }
  class ProblemDetailsFilter {
    <<filter · RFC 9457>>
  }

  %% ===================== src/modules (composition root) =====================
  class FeatureModules {
    <<Nest modules · composition root>>
    +modules: Auth, Progress, Leaderboard, Levels
    +providers: token → adaptador, use case → aspectos
  }

  %% ===================== RELACIONES =====================
  GameProgress o-- "0..*" LevelProgress : progreso por nivel
  ProgressController ..> GameIdPipe : valida gameId
  BestScoreRanking ..|> IRankingStrategy
  SortLevelSpecValidator ..|> ILevelSpecValidator : gameId = hexa-sort

  RegisterUserUseCase ..|> UseCase
  LoginUseCase ..|> UseCase
  SyncProgressUseCase ..|> UseCase
  SubmitScoreUseCase ..|> UseCase
  GetLeaderboardUseCase ..|> UseCase
  GetLevelsUseCase ..|> UseCase
  UpsertLevelUseCase ..|> UseCase
  LoggingUseCase ..|> UseCase
  LoggingUseCase o-- "1" UseCase : inner

  NestLogAdapter ..|> LogPort
  LoggingUseCase --> LogPort
  FeatureModules ..> NestLogAdapter : inyecta
  RegisterUserUseCase --> UserRepository
  RegisterUserUseCase --> PasswordHasher
  LoginUseCase --> UserRepository
  LoginUseCase --> PasswordHasher
  LoginUseCase --> TokenService
  SyncProgressUseCase --> ProgressRepository
  SyncProgressUseCase ..> GameProgress : mergeMonotonic
  SyncProgressUseCase o-- "0..*" IProgressMergePolicy
  KeepLatestDataPolicy ..|> IProgressMergePolicy
  SubmitScoreUseCase --> ScoreRepository
  GetLeaderboardUseCase --> ScoreRepository
  GetLeaderboardUseCase o-- "0..*" IRankingStrategy
  GetLevelsUseCase --> LevelRepository
  UpsertLevelUseCase --> LevelRepository
  UpsertLevelUseCase o-- "*" ILevelSpecValidator

  PrismaUserRepository ..|> UserRepository
  PrismaProgressRepository ..|> ProgressRepository
  PrismaScoreRepository ..|> ScoreRepository
  PrismaLevelRepository ..|> LevelRepository
  BcryptPasswordHasher ..|> PasswordHasher
  JwtTokenService ..|> TokenService
  PrismaUserRepository --> PrismaService
  PrismaProgressRepository --> PrismaService
  PrismaScoreRepository --> PrismaService
  PrismaLevelRepository --> PrismaService

  ReadProgressUseCase ..|> UseCase
  ReadProgressUseCase --> ProgressRepository
  ReadProfileUseCase ..|> UseCase
  ReadProfileUseCase --> UserRepository
  LevelsController ..> AdminGuard : PUT
  ProgressController ..> JwtAuthGuard
  LeaderboardController ..> JwtAuthGuard : POST scores
  AuthController ..> JwtAuthGuard : GET /me
  AdminGuard ..> JwtAuthGuard : va después
  AuthController ..> ReadProfileUseCase : GET /me
  ProgressController ..> ReadProgressUseCase : GET
  AuthController --> UseCase : Register / Login
  ProgressController --> UseCase : SyncProgress
  LeaderboardController --> UseCase : SubmitScore / GetLeaderboard
  LevelsController --> UseCase : GetLevels / UpsertLevel
  JwtAuthGuard --> TokenService
  LeaderboardController ..> GameIdPipe : valida gameId
  LevelsController ..> GameIdPipe : valida gameId
  ProblemDetailsFilter ..> DomainError : traduce a problem+json
  FeatureModules ..> PrismaProgressRepository : bind tokens
  FeatureModules ..> LoggingUseCase : envuelve

  note for IRankingStrategy "Una variante que gana por menos tiempo o<br>menos movimientos registra su estrategia para<br>su gameId. ScoreEntry ya trae moves y elapsedMs:<br>GetLeaderboardUseCase no se modifica."
  note for IProgressMergePolicy "bestScore y niveles completados se fusionan<br>siempre igual (nunca se pierde progreso). La parte<br>propia de cada juego va en data (columna Json en<br>Prisma): una variante nueva no exige migración."
  note for SortLevelSpecValidator "spec.goal es UNA de dos formas:<br>{type: score, target} o<br>{type: colors, required: {color: n}}.<br>Rechaza niveles sin meta o con las dos."
  note for LevelDefinition "Mismo esquema para toda variante por niveles<br>(schemas/level.schema.json); la sección spec<br>la valida el ILevelSpecValidator de su gameId.<br>Persistir board y spec en la misma operación."
  note for GameProgress "Fusión monótona: bestScore = máx,<br>mejor marca = máx por nivel,<br>niveles completados = unión. Sincronizar es<br>idempotente y nunca pierde progreso."

  %% ===================== LEYENDA =====================
  class LEG1["Capa 1 · Entidades (src/domain)"]
  class LEG2["Capa 2 · Casos de uso (src/application)"]
  class LEG3["Capa 3 · Adaptadores (infrastructure · interfaces/http)"]
  class LEG5["Borde naranja = punto de extensión por gameId"]
