{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hexablock.local/schemas/level.schema.json",
  "title": "HexaBlock level definition",
  "description": "Class model v6.3. Shared envelope for every level-based variant; the spec section is validated per gameId (ILevelSpecValidator). Hexa Sort is the only level-based variant.",
  "type": "object",
  "required": ["schemaVersion", "gameId", "levelId", "order", "board", "spec"],
  "properties": {
    "schemaVersion": {
      "description": "Wire format version.",
      "const": 1
    },
    "version": {
      "description": "Content revision, managed by the server. Ignored when publishing.",
      "type": "integer",
      "minimum": 1
    },
    "gameId": {
      "enum": ["hexa-sort"]
    },
    "levelId": {
      "type": "string",
      "pattern": "^sort-[0-9]{3}$"
    },
    "order": {
      "type": "integer",
      "minimum": 1
    },
    "difficulty": {
      "enum": ["easy", "medium", "hard"]
    },
    "board": {
      "oneOf": [
        {
          "type": "object",
          "required": ["shape", "radius"],
          "properties": {
            "shape": {
              "const": "hexagon"
            },
            "radius": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "required": ["shape", "cells"],
          "properties": {
            "shape": {
              "const": "custom"
            },
            "cells": {
              "$ref": "#/$defs/cells"
            }
          }
        }
      ]
    },
    "spec": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "gameId": {
            "const": "hexa-sort"
          }
        }
      },
      "then": {
        "properties": {
          "spec": {
            "required": ["goal", "colors", "seed"],
            "properties": {
              "goal": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/scoreGoal"
                  },
                  {
                    "$ref": "#/$defs/colorsGoal"
                  }
                ]
              },
              "colors": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 2
              },
              "seed": {
                "type": "integer"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "integer"
          },
          {
            "type": "integer"
          }
        ],
        "minItems": 2,
        "maxItems": 2
      }
    },
    "scoreGoal": {
      "type": "object",
      "required": ["type", "target"],
      "properties": {
        "type": {
          "const": "score"
        },
        "target": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "colorsGoal": {
      "type": "object",
      "required": ["type", "required"],
      "properties": {
        "type": {
          "const": "colors"
        },
        "required": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "additionalProperties": false
    }
  }
}
